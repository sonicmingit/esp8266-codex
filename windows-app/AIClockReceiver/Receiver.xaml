<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 额度接收端" WindowStyle="None" ResizeMode="NoResize" SizeToContent="Height"
        Width="358" WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        Background="{DynamicResource Paper}" Foreground="{DynamicResource Ink}">
  <Window.Resources>
    <SolidColorBrush x:Key="Paper" Color="#151413"/>
    <SolidColorBrush x:Key="Ink" Color="#F8F6F2"/>
    <SolidColorBrush x:Key="Number" Color="#F8F6F2"/>
    <SolidColorBrush x:Key="ResetInk" Color="#F58A61"/>
    <SolidColorBrush x:Key="Quiet" Color="#C2BAB3"/>
    <SolidColorBrush x:Key="Line" Color="#494440"/>
    <SolidColorBrush x:Key="Meter" Color="#78DC91"/>
    <SolidColorBrush x:Key="Claude" Color="#F58A61"/>
    <SolidColorBrush x:Key="Codex" Color="#A1A8FF"/>
    <Style TargetType="Button">
      <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/>
      <Setter Property="Foreground" Value="{DynamicResource Quiet}"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="15"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="Transparent" CornerRadius="4">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Line}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="1"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Ink}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ProviderName" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="19"/>
      <Setter Property="Foreground" Value="{DynamicResource Claude}"/>
      <Style.Triggers><DataTrigger Binding="{Binding Name}" Value="Codex"><Setter Property="Foreground" Value="{DynamicResource Codex}"/></DataTrigger></Style.Triggers>
    </Style>
    <DataTemplate x:Key="WindowData">
      <StackPanel Margin="0,2,0,6" ToolTip="{Binding Reset}" AutomationProperties.HelpText="{Binding Reset}">
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Right" Text="{Binding Percent}" FontWeight="SemiBold" Foreground="{DynamicResource Number}">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="28"/>
              <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="FontSize" Value="21"/></DataTrigger></Style.Triggers>
            </Style></TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{DynamicResource Quiet}"/>
        </DockPanel>
        <ProgressBar Value="{Binding DisplayValue, Mode=OneWay}" Maximum="100" Height="5" Margin="0,4"
                     AutomationProperties.Name="{Binding Label}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
          <ProgressBar.Template><ControlTemplate TargetType="ProgressBar">
            <Grid x:Name="PART_Track"><Border CornerRadius="2" Background="{DynamicResource Line}"/>
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2" Background="{TemplateBinding Foreground}"/>
            </Grid>
          </ControlTemplate></ProgressBar.Template>
        </ProgressBar>
        <TextBlock Text="{Binding Reset}" Foreground="{DynamicResource ResetInk}" FontSize="12">
          <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
            <MultiDataTrigger><MultiDataTrigger.Conditions>
              <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
              <Condition Binding="{Binding Items.Count, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="2"/>
            </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger>
          </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="Readouts">
      <StackPanel VerticalAlignment="Center">
        <ItemsControl ItemsSource="{Binding Windows}" ItemTemplate="{StaticResource WindowData}"
                      Foreground="{DynamicResource Meter}"/>
        <TextBlock Text="暂无额度数据" Foreground="{DynamicResource Quiet}" FontSize="14">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding Windows.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style></TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="Column">
      <StackPanel Margin="14,10,14,6">
        <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Image Source="{Binding Pet}" Height="60" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,0,0">
            <TextBlock Text="{Binding Name}" Style="{StaticResource ProviderName}"/>
            <TextBlock Text="{Binding Activity}"/>
          </StackPanel>
        </Grid>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Readouts}" Focusable="False"/>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>
  <Border BorderThickness="1" BorderBrush="{DynamicResource Line}">
    <StackPanel>
      <Grid x:Name="Strip" Visibility="Collapsed" Height="65" Background="{DynamicResource Paper}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="90"/><ColumnDefinition Width="1"/><ColumnDefinition/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
        <Image Source="{Binding Pet}" Margin="6,5,0,5" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
          <TextBlock x:Name="StripName" Text="{Binding Name, FallbackValue=AI 额度}" Style="{StaticResource ProviderName}"/>
          <TextBlock x:Name="StripActivity" Text="{Binding Activity}" Foreground="{DynamicResource Quiet}" FontSize="12"/>
        </StackPanel>
        <Border Grid.Column="2" Background="{DynamicResource Line}" Margin="0,13"/>
        <ItemsControl Grid.Column="3" ItemsSource="{Binding Windows}" VerticalAlignment="Center" Margin="10,0,0,0">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <StackPanel MinWidth="77" ToolTip="{Binding Reset}">
              <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{DynamicResource Quiet}"/>
              <TextBlock Text="{Binding Percent}" FontSize="22" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
            </StackPanel>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="StripHint" Grid.Column="3" VerticalAlignment="Center" Margin="11,0,0,0" Foreground="{DynamicResource Quiet}" TextTrimming="CharacterEllipsis"/>
        <Button x:Name="Expand" Grid.Column="4" Content="&#xE70D;" ToolTip="展开窗口" AutomationProperties.Name="展开窗口"/>
      </Grid>
      <DockPanel x:Name="TitleBar" Background="Transparent" Margin="12,6,4,4">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button x:Name="Collapse" ToolTip="切换到窄栏" AutomationProperties.Name="切换到窄栏" Content="&#xE70E;"/>
          <Button x:Name="Pin" ToolTip="窗口置顶" AutomationProperties.Name="窗口置顶" Content="&#xE718;"/>
          <Button x:Name="Settings" ToolTip="设置" AutomationProperties.Name="设置" Content="&#xE713;"/>
          <Button x:Name="Close" ToolTip="关闭" AutomationProperties.Name="关闭" Content="&#xE8BB;"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="Heading" Text="AI 额度" FontSize="19" FontWeight="SemiBold"/>
          <TextBlock x:Name="Activity" Text="{Binding Activity}" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>
      <Border x:Name="TopRule" Height="1" Background="{DynamicResource Line}"/>
      <Grid x:Name="Single" Margin="13,8,16,8" MinHeight="145">
        <Grid.ColumnDefinitions><ColumnDefinition Width="119"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Image Source="{Binding Pet}" Width="117" Height="132" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        <ContentControl Grid.Column="1" Margin="10,0,0,0" Content="{Binding}" ContentTemplate="{StaticResource Readouts}" VerticalAlignment="Center" Focusable="False"/>
      </Grid>
      <Grid x:Name="Dual" Visibility="Collapsed" MinHeight="164">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <ContentControl x:Name="LeftColumn" ContentTemplate="{StaticResource Column}" Focusable="False"/>
        <Border Grid.Column="1" Background="{DynamicResource Line}"/>
        <ContentControl x:Name="RightColumn" Grid.Column="2" ContentTemplate="{StaticResource Column}" Focusable="False"/>
      </Grid>
      <StackPanel x:Name="Empty" Margin="14,28,14,28" HorizontalAlignment="Center">
        <TextBlock x:Name="EmptyTitle" Text="连接你的桥接服务" FontSize="19" TextAlignment="Center"/>
        <TextBlock x:Name="EmptyHint" Text="在设置中填写发射端地址" Margin="0,7,0,0" Foreground="{DynamicResource Quiet}" TextWrapping="Wrap" TextAlignment="Center"/>
      </StackPanel>
      <Border x:Name="FooterRule" Height="1" Background="{DynamicResource Line}"/>
      <DockPanel x:Name="FooterBar" Margin="12,1,4,1">
        <Button x:Name="Refresh" Content="&#xE72C;" DockPanel.Dock="Right" AutomationProperties.Name="刷新" ToolTip="刷新"/>
        <TextBlock x:Name="Footer" FontSize="12" Foreground="{DynamicResource Quiet}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </StackPanel>
  </Border>
</Window>
