<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="选择桌宠" Width="486" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" Background="#FAF8F4" Foreground="#292623">
  <Border Padding="20"><StackPanel>
    <TextBlock x:Name="PetTitle" FontWeight="SemiBold" FontSize="21"/>
    <Label Target="{Binding ElementName=Search}" Padding="0" Margin="0,12,0,3">搜索 Petdex 宠物</Label>
    <TextBox x:Name="Search" Padding="7,5"/>
    <Grid Margin="0,12,0,8" Height="222">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ListBox x:Name="List" AutomationProperties.Name="宠物目录" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderBrush="#D2CEC5">
        <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6,4" ToolTip="{Binding Slug}">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Slug}" Foreground="#625B53" FontSize="11" TextTrimming="CharacterEllipsis"/>
        </StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
        <Image x:Name="Preview" Height="120" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        <TextBlock x:Name="PetName" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
        <ComboBox x:Name="Action" Margin="16,8" SelectedIndex="0" AutomationProperties.Name="预览动作"><ComboBoxItem>待机</ComboBoxItem><ComboBoxItem>工作</ComboBoxItem><ComboBoxItem>待确认</ComboBoxItem></ComboBox>
      </StackPanel>
    </Grid>
    <TextBlock x:Name="Info" Foreground="#625B53" TextWrapping="Wrap"/>
    <DockPanel Margin="0,12,0,0"><Button x:Name="DefaultPet" DockPanel.Dock="Left" HorizontalAlignment="Left" Padding="8,4">恢复内置宠物</Button>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True" Padding="10,4" Margin="0,0,6,0"/><Button x:Name="Choose" IsEnabled="False" IsDefault="True" Padding="10,4">选用</Button></StackPanel>
    </DockPanel>
  </StackPanel></Border>
</Window>
