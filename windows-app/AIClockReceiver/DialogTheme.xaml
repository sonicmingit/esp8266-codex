<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Field" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Edge" Color="#D2CEC5"/>
  <SolidColorBrush x:Key="Hover" Color="#EFEEE8"/>
  <SolidColorBrush x:Key="Focus" Color="#386849"/>
  <SolidColorBrush x:Key="Primary" Color="#294E39"/>
  <Style TargetType="Button">
    <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="12,5"/>
    <Setter Property="Foreground" Value="#302F29"/><Setter Property="Background" Value="{StaticResource Field}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Focus}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Focus}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".75"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".5"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="IsDefault" Value="True"><Setter Property="Background" Value="{StaticResource Primary}"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource Field}"/><Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <Border x:Name="Surface" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
        <ScrollViewer x:Name="PART_ContentHost"/>
      </Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Focus}"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Padding" Value="9,5"/><Setter Property="MinHeight" Value="32"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid>
        <ToggleButton x:Name="Drop" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Surface" Background="{StaticResource Field}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="5"/>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource Hover}"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter IsHitTestVisible="False" Margin="10,0,29,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
        <TextBlock IsHitTestVisible="False" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE70D;"/>
        <Border x:Name="FocusBorder" IsHitTestVisible="False" CornerRadius="5" BorderBrush="{StaticResource Focus}" BorderThickness="0"/>
        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
          <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="5" Margin="0,2,0,0" Padding="3" MinWidth="{Binding ActualWidth, ElementName=Drop}">
            <ScrollViewer MaxHeight="230"><ItemsPresenter/></ScrollViewer>
          </Border>
        </Popup>
      </Grid><ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusBorder" Property="BorderThickness" Value="1"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".55"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
